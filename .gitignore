# workspace/ — território de trabalho
# input/output/extracted/reports: efêmeros (só .gitkeep versionado)
# context/ e scripts/: material de apoio VERSIONADO

workspace/*
!workspace/.gitkeep
!workspace/*/

workspace/input/*
!workspace/input/.gitkeep

workspace/output/*
!workspace/output/.gitkeep

workspace/extracted/*
!workspace/extracted/.gitkeep

workspace/reports/*
!workspace/reports/.gitkeep

extracted/*
!extracted/.gitkeep

output/*
!output/.gitkeep

reports/*
!reports/.gitkeep

*.iso
*.bin
*.img
*.cue
*.7z
*.zip
*.rar

__pycache__/
*.pyc
